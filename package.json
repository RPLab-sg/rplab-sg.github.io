{
  "name": "rplab-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=26.0.0 <27",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "sirv build/client --host 127.0.0.1 --port 4173 --no-clear",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run content:check && npm run typecheck && npm run lint && npm run format:check",
    "content:check": "node scripts/validate-content.ts"
  },
  "dependencies": {
    "isbot": "5.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "overrides": {
    "minimatch": "11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@react-router/dev": "8.5.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "sirv-cli": "3.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "zod": "4.6.7"
  }
}
